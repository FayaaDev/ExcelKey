{
  "name": "excelkey-ref",
  "version": "1.12.1",
  "type": "module",
  "description": "Reference implementation of ExcelKey: passkey + PRF end-to-end file encryption.",
  "license": "GPL-3.0-or-later",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run build:web",
    "test": "bun test",
    "e2e": "node e2e/run.mjs",
    "vectors": "bun run test/gen-vectors.ts",
    "gen:source": "bun run web/gen-source.ts",
    "gen:icons": "node e2e/gen-icons.mjs",
    "gen:og": "node e2e/gen-og.mjs",
    "build:recover": "bun run web/build-recover.ts",
    "build:web": "bun run web/gen-source.ts && bun build web/excel-app.ts web/app.ts web/worker.ts web/selftest.ts --outdir web/dist --target browser --minify && bun run web/build-recover.ts && bun run web/build-blog.ts",
    "serve": "bun run web/serve.ts"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "qrcode-generator": "^2.0.4",
    "saxes": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
